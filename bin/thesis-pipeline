#!/usr/bin/env bash
# ==============================================================================
# WRITING SUITE - Modern Academic Engine CLI
# Unified 4-Pillar Forensic Engine (MPS Surprisal, Stylometry, Embeddings, DeBERTa)
# ==============================================================================

set -e

export HF_HUB_DISABLE_PROGRESS_BARS=1
export TRANSFORMERS_VERBOSITY=error
export TOKENIZERS_PARALLELISM=false
export PYTHONWARNINGS="ignore::FutureWarning"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Rilevamento uv prioritario (come da direttiva utente) o fallback su venv
if command -v uv >/dev/null 2>&1 && [ -f "$WS_DIR/pyproject.toml" ]; then
    RUN_CMD="uv run --directory $WS_DIR python"
elif [ -d "$WS_DIR/.venv/bin" ]; then
    RUN_CMD="$WS_DIR/.venv/bin/python"
else
    RUN_CMD="python3"
fi


function usage() {
    echo "Writing Suite v2.0 - Modern Academic & Neural Forensic CLI"
    echo "Uso: writing-suite <comando> [opzioni]"
    echo ""
    echo "Comandi disponibili:"
    echo "  evaluate <file|cartella>   Esegue l'audit moderno a 4 pilastri con Visual Heatmap"
    echo "  heatmap <file|cartella>    Alias per evaluate con visualizzazione per paragrafo"
    echo "  citations <file> [bib]     Verifica integrità citazionale, claim non dimostrati e chiavi .bib"
    echo "  check-live <file|testo>    Invia a CleverHumanizer.ai Detector via Chromium headless live"
    echo "  compile [main.typ]         Compila la tesi con Typst e certifica 0 errori"
    echo ""
    echo "Esempi:"
    echo "  writing-suite evaluate chapters/ch1_intro.typ"
    echo "  writing-suite citations chapters/ch1_intro.typ references.bib"
    echo "  writing-suite check-live chapters/ch1_intro.typ"
    echo "  writing-suite compile"
    exit 0
}

CMD="$1"
shift || true

if [ -z "$CMD" ] || [ "$CMD" = "--help" ] || [ "$CMD" = "-h" ] || [ "$CMD" = "help" ]; then
    usage
fi

case "$CMD" in
    evaluate|heatmap|audit|suggest)
        TARGET="${1:-.}"
        CROSS_VAL="False"
        if [ "$2" = "--cross-validate" ] || [ "$2" = "--live" ] || [ "$1" = "--cross-validate" ]; then
            CROSS_VAL="True"
            if [ "$1" = "--cross-validate" ]; then TARGET="."; fi
        fi
        $RUN_CMD -c "
import sys, os
sys.path.insert(0, '$WS_DIR/mcp')
from core.modern_evaluator import evaluate_document_modern, render_heatmap_cli

target = '$TARGET'
cross_val = ($CROSS_VAL == True)
if os.path.isdir(target):
    files = sorted([os.path.join(target, f) for f in os.listdir(target) if f.endswith(('.typ', '.tex', '.md'))])
    for f_path in files:
        with open(f_path) as f:
            text = f.read()
        rep = evaluate_document_modern(text, f_path, cross_validate=cross_val)
        print(render_heatmap_cli(rep))
        print('\n')
elif os.path.isfile(target):
    with open(target) as f:
        text = f.read()
    rep = evaluate_document_modern(text, target, cross_validate=cross_val)
    print(render_heatmap_cli(rep))
else:
    print(f'File o cartella non trovata: {target}')
"
        ;;

    citations)
        TARGET="$1"
        BIB="${2:-/Users/tella/Workspace/PyChain/thesis_typst/references.bib}"
        if [ -z "$TARGET" ]; then
            echo "Uso: writing-suite citations <file.typ> [references.bib]"
            exit 1
        fi
        $RUN_CMD -c "
import sys
sys.path.insert(0, '$WS_DIR/mcp')
from core.citations import audit_citations
with open('$TARGET') as f:
    text = f.read()
res = audit_citations(text, '$BIB')
print(f'=== AUDIT CITAZIONALE E RIGORE SCIENTIFICO: $TARGET ===')
print(f'Citazioni trovate nel testo: {res[\"total_citations_found\"]}')
if res['bib_path_provided']:
    print(f'File .bib verificato: $BIB ({res[\"bib_total_entries\"]} voci)')
    if res['missing_in_bib']:
        print(f'🔴 ALLUCINAZIONI / CHIAVI ASSENTI NEL .BIB ({len(res[\"missing_in_bib\"])}):')
        for k in res['missing_in_bib']:
            print(f'  ❌ @{k}')
    else:
        print('✅ 100% delle citazioni sono verificate nel file .bib!')
if res['unsupported_claims']:
    print(f'\n⚠️ AFFERMAZIONI NON DIMOSTRATE O SENZA FONTE ({res[\"unsupported_claims_count\"]}):')
    for c in res['unsupported_claims']:
        print(f'  Riga {c[\"line\"]}: [{c[\"type\"]}] \"{c[\"matched_text\"]}\"')
        print(f'     -> {c[\"message\"]}')
else:
    print('✅ Zero affermazioni apodittiche o non dimostrate rilevate!')
"
        ;;

    check-live)
        TARGET="$1"
        if [ -z "$TARGET" ]; then
            echo "Errore: specificare il file o il testo da verificare con i detector commerciali."
            exit 1
        fi
        if [ -f "$TARGET" ]; then
            $RUN_CMD "$WS_DIR/mcp/core/external_detector.py" --file "$TARGET" --action multi
        else
            $RUN_CMD "$WS_DIR/mcp/core/external_detector.py" --text "$TARGET" --action multi
        fi
        ;;

    compile)
        TARGET="${1:-/Users/tella/Workspace/PyChain/thesis_typst/main.typ}"
        echo "Compilazione Typst in corso per $TARGET..."
        typst compile "$TARGET"
        echo "Compilazione completata con successo! PDF aggiornato."
        ;;

    *)
        usage
        ;;
esac
