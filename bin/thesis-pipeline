#!/usr/bin/env bash
# ==============================================================================
# Thesis Pipeline - Universal CLI for Academic Writing & Humanization
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
if [ ! -d "$WS_DIR/mcp/core" ]; then
    WS_DIR="/Users/tella/Workspace/writing-suite"
fi
if [ -f "$WS_DIR/.venv/bin/python" ]; then
    VENV_PY="$WS_DIR/.venv/bin/python"
elif command -v uv &> /dev/null; then
    uv venv "$WS_DIR/.venv" --python 3.12 >/dev/null 2>&1
    uv pip install torch transformers safetensors huggingface-hub --python "$WS_DIR/.venv/bin/python" >/dev/null 2>&1
    VENV_PY="$WS_DIR/.venv/bin/python"
else
    VENV_PY="python3"
fi

DEFAULT_TERMS="EVM,Sepolia,SWHID,IPFS,PyPI,Layer-2,Merkle DAG,in-toto,TUF,Sigstore"

function usage() {
    echo "Uso: thesis-pipeline <comando> [opzioni]"
    echo ""
    echo "Comandi disponibili:"
    echo "  audit <file|cartella>       Esegue l'audit a 7 lenti (Linter, GLTR, GPTZero, MPS Neural, etc.)"
    echo "  suggest <file|testo>        Analizza frase per frase e fornisce suggerimenti di riscrittura azionabili"
    echo "  macro <file>                Analizza la macro-struttura (iper-frammentazione, sezioni corte, fusioni)"
    echo "  humanize <file|cartella>    Riscrive in anello chiuso via Ollama locale (Qwen2.5 / GoHumanize) con Meaning Lock"
    echo "  check-live <file|testo>     Invia a CleverHumanizer.ai Detector via Chromium headless live"
    echo "  humanize-live <file|testo>  Riscrive tramite CleverHumanizer.ai Humanizer via Chromium headless"
    echo "  compile [main.typ]          Compila la tesi con Typst e controlla gli errori"
    echo ""
    echo "Esempi:"
    echo "  thesis-pipeline audit chapters/"
    echo "  thesis-pipeline audit chapters/ch2_background.typ"
    echo "  thesis-pipeline humanize chapters/ch2_background.typ"
    echo "  thesis-pipeline check-live chapters/ch1_intro.typ"
    echo "  thesis-pipeline compile"
    exit 1
}

CMD="$1"
shift || true

case "$CMD" in
    audit|evaluate)
        TARGET="${1:-.}"
        "$VENV_PY" "$WS_DIR/mcp/core/pipeline.py" --project "$TARGET" --mode audit --terms "$DEFAULT_TERMS" 2>/dev/null || \
        "$VENV_PY" "$WS_DIR/mcp/core/pipeline.py" --file "$TARGET" --mode audit --terms "$DEFAULT_TERMS"
        ;;
    humanize)
        TARGET="$1"
        if [ -z "$TARGET" ]; then
            echo "Errore: specificare il file o la directory da umanizzare."
            exit 1
        fi
        "$VENV_PY" "$WS_DIR/mcp/core/pipeline.py" --file "$TARGET" --mode humanize --terms "$DEFAULT_TERMS" 2>/dev/null || \
        "$VENV_PY" "$WS_DIR/mcp/core/pipeline.py" --project "$TARGET" --mode humanize --terms "$DEFAULT_TERMS"
        ;;
    check-live)
        TARGET="$1"
        if [ -z "$TARGET" ]; then
            echo "Errore: specificare il file o il testo da verificare."
            exit 1
        fi
        if [ -f "$TARGET" ]; then
            "$VENV_PY" "$WS_DIR/mcp/core/external_detector.py" --file "$TARGET" --action check
        else
            "$VENV_PY" "$WS_DIR/mcp/core/external_detector.py" --text "$TARGET" --action check
        fi
        ;;
    humanize-live)
        TARGET="$1"
        if [ -z "$TARGET" ]; then
            echo "Errore: specificare il file o il testo da umanizzare."
            exit 1
        fi
        if [ -f "$TARGET" ]; then
            "$VENV_PY" "$WS_DIR/mcp/core/external_detector.py" --file "$TARGET" --action humanize --mode clear_structured
        else
            "$VENV_PY" "$WS_DIR/mcp/core/external_detector.py" --text "$TARGET" --action humanize --mode clear_structured
        fi
        ;;
    suggest)
        TARGET="$1"
        if [ -z "$TARGET" ]; then
            echo "Errore: specificare il file o il testo da analizzare."
            exit 1
        fi
        if [ -f "$TARGET" ]; then
            CONTENT=$(cat "$TARGET")
        else
            CONTENT="$TARGET"
        fi
        "$VENV_PY" -c "
import sys
sys.path.insert(0, '$WS_DIR/mcp')
from core.suggest import suggest_improvements
content = sys.stdin.read()
res = suggest_improvements(content)
if 'error' in res:
    print(f'Avviso: {res[\"error\"]}')
    sys.exit(0)
print(f'=== DIAGNOSI DI RIGORE E SALUTE TESTUALE ({res[\"overall_health\"]}) ===')
print(f'Frasi analizzate: {res[\"total_sentences\"]} | Ad alto rischio AI: {res[\"high_risk_sentences\"]} | Hotspot Paragrafi: {res.get(\"hotspots_count\", 0)}')
if res.get('hotspots'):
    print('\n=== CLUSTER PARAGRAFI AD ALTO RISCHIO (SLIDING WINDOW HOTSPOTS) ===')
    for h in res['hotspots']:
        print(f'  {h[\"badge\"]} ({h[\"ai_probability\"]}%) [Token {h[\"start_token\"]}-{h[\"end_token\"]}]: {h[\"snippet\"]}')
for s in res['sentences']:
    print(f'\n[Frase {s[\"index\"]}] {s[\"badge\"]} ({s[\"ai_probability\"]}%) [{s[\"word_count\"]} parole]')
    print(f'  Testo: {s[\"text\"][:100]}...')
    if s.get('context_anomaly'):
        print(f'  ⚠️ [DISCREPANZA CONTESTUALE]: Singola={s.get(\"standalone_probability\")}% | Nel flusso={s.get(\"context_probability\")}% (+{s.get(\"context_penalty\")}%)')
    for f in s['flaws']:
        print(f'  --> [{f[\"type\"]}] {f[\"rule\"]}')
        print(f'      SUGGERIMENTO: {f[\"fix\"]}')
print('\n=== PIANO D\'AZIONE RACCOMANDATO ===')
for a in res['action_plan']:
    print(f'  {a}')
" <<< "$CONTENT"
        ;;
    macro)
        TARGET="$1"
        if [ -z "$TARGET" ]; then
            echo "Errore: specificare il file da analizzare strutturalmente."
            exit 1
        fi
        if [ -f "$TARGET" ]; then
            CONTENT=$(cat "$TARGET")
        else
            CONTENT="$TARGET"
        fi
        "$VENV_PY" -c "
import sys
sys.path.insert(0, '$WS_DIR/mcp')
from core.macro_analyzer import analyze_macro_structure
content = sys.stdin.read()
res = analyze_macro_structure(content, file_path='$TARGET')
print(f'=== ANALISI MACRO-STRUTTURALE: {res[\"macro_health\"]} ===')
print(f'Sezioni totali: {res[\"total_sections\"]} | Parole medie/sezione: {res[\"average_words_per_section\"]} | Sezioni micro-frammentate (<90w): {res[\"too_short_sections_count\"]}')
print('\n--- MAPPATURA SEZIONI ---')
for s in res['sections']:
    flag = '⚠️ [TROPPO CORTA]' if s['is_too_short'] else '✅ [OK]'
    indent = '  ' * (s['level'] - 1)
    print(f'{indent}L{s[\"level\"]} {s[\"title\"]} ({s[\"word_count\"]} parole) {flag}')
if res['flaws']:
    print('\n--- CRITICITÀ RILEVATE ---')
    for fl in res['flaws']:
        print(f'  [{fl[\"issue\"]}] {fl[\"description\"]}')
print('\n--- RACCOMANDAZIONI DI FUSIONE / FLUIDIFICAZIONE ---')
for rec in res['recommendations']:
    print(f'  • {rec}')
" <<< "$CONTENT"
        ;;
    compile)
        TARGET="${1:-/Users/tella/Workspace/PyChain/thesis_typst/main.typ}"
        echo "Compilazione Typst in corso per $TARGET..."
        typst compile "$TARGET"
        echo "Compilazione completata con successo! PDF aggiornato."
        ;;
    *)
        usage
        ;;
esac
